POSTGRES_URL=postgres://platform:platform@localhost:5432/a2a_platform
REDIS_URL=redis://localhost:6379
PLATFORM_ORIGIN=http://localhost:8080
CONSOLE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
PLATFORM_DEV_TOKEN=dev-admin-token
PLATFORM_JWT_SECRET=replace-with-at-least-32-random-characters
PLATFORM_JWT_ISSUER=a2a-agent-platform
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_DAYS=30
LOCAL_LOGIN_ENABLED=true
SELF_REGISTRATION_ENABLED=true
CONSOLE_PUBLIC_ORIGIN=http://localhost:5173
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-dedicated-random-encryption-key
CREDENTIAL_KEY_VERSION=v1
CREDENTIAL_PREVIOUS_KEYS={}
SMTP_URL=
SMTP_FROM=a2a-platform@localhost
METRICS_TOKEN=
PUBLIC_AGENT_CATALOG=true
ALLOW_PRIVATE_OUTBOUND_TARGETS=true
PORT=3000
HEALTH_CHECK_INTERVAL_MS=30000
RATE_LIMIT_PER_MINUTE=120
MAX_A2A_RESPONSE_BYTES=16777216
MAX_A2A_EVENT_BYTES=1048576
MAX_A2A_STREAM_EVENTS=10000
